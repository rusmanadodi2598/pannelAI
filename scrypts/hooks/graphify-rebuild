#!/usr/bin/env bash
# Hook helper: refresh the graphify graph in the background after a commit or push.
#
# Why this is a separate script instead of inline hook code: the trigger has to
# return at once, while the work takes tens of seconds. A commit that waits for a
# graph rebuild is a commit people learn to bypass with --no-verify, and a
# bypassed hook protects nothing. So the hooks only record what changed and hand
# off; this script detaches, takes a lock, and does the rebuild.
#
# Two modes, one script:
#   detach  - called by the hooks. Records the changed paths, starts `run` fully
#             detached, and returns immediately.
#   run     - the actual rebuild. Always exits 0: a background graph refresh must
#             never become a failed commit or a blocked push.
#
# Why incremental: `graphify update` re-extracts only the changed code files and
# merges them into the existing graph, leaving the semantic (doc/paper/image)
# layer untouched. `graphify extract` is the incremental AST + LLM variant and is
# opt-in here, because its headless semantic pass is much thinner than the
# assistant-driven one - see the note at the call site.
#
# Why the throttle: a rebuild costs ~45s of CPU even when nothing in the corpus
# changed, because a few hundred files fail to parse and so never enter the cache.
# Without a floor, a run of small commits would keep two workers busy without
# pause. A trigger inside the window marks the work pending instead, and a single
# follow-up run picks it up when the current one finishes, so the last commit in a
# burst still ends up in the graph.
#
# Usage: graphify-rebuild detach <changed-file-list>
#        graphify-rebuild run
#
# Tuning: GRAPHIFY_REBUILD_THROTTLE (seconds, default 900)
#         GRAPHIFY_REBUILD_DOCS=1      also re-extract changed docs via the LLM
#         GRAPHIFY_REBUILD_TIMEOUT (s, default 1800) kill a wedged rebuild

set -euo pipefail
. "$(dirname "$0")/../lib/common.sh"

root="$(repo_root)"
out="$root/graphify-out"
log="$out/rebuild.log"
# Deliberately NOT graphify-out/.rebuild.lock: that is graphify's own lock
# (graphify/watch.py), and graphify takes it in BLOCKING mode. Holding the same
# path from here deadlocks the rebuild against itself, which is exactly what an
# earlier version of this script did. Different concern, different file: this one
# keeps two hook rebuilds from overlapping, graphify's keeps graph.json writers
# from colliding.
lock="$out/.hook-rebuild.lock"
stamp="$out/.rebuild.last"
pending="$out/.rebuild.pending"
deferred="$out/.rebuild.deferred"
changed="$out/.rebuild.changed"
throttle="${GRAPHIFY_REBUILD_THROTTLE:-900}"
timeout_s="${GRAPHIFY_REBUILD_TIMEOUT:-1800}"

log_line() {
	printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$log"
}

# classify_changed <code|llm> reports whether any changed path is a file
# graphify routes to that half of the pipeline: "code" for the AST pass that
# `graphify update` re-runs, "llm" for the doc/paper/image pass it does not
# touch. It asks graphify itself - detect.classify_file - instead of keeping a
# copy of the extension lists, so an extensionless hook script is classified by
# its shebang, a package manifest by name, and the answer cannot drift from the
# way the graph was actually built. An earlier version asked "not in
# CODE_EXTENSIONS", which called every extensionless hook file a document and
# printed a doc advisory for a commit that touched only shell scripts.
#
# A deleted path cannot be classified from disk, so it falls back to
# manifest.json: a file the graph still holds counts as code, which is what
# makes a deletion trigger the rebuild that drops its nodes.
#
# If graphify cannot be imported the answer degrades in the safe direction:
# "code" rebuilds (wasted work at worst), "llm" stays quiet (this answer only
# drives an advisory log line, and a false alarm is worse than silence).
classify_changed() {
	[ -s "$changed" ] || return 1
	local py="python3"
	if [ -x "$out/.graphify_python" ]; then
		py="$(cat "$out/.graphify_python")"
	fi
	"$py" - "$root" "$changed" "$1" <<'PY'
import json
import sys
from pathlib import Path

kind = sys.argv[3]
root = Path(sys.argv[1])
manifest = root / "graphify-out" / "manifest.json"
try:
    indexed = set(json.loads(manifest.read_text(encoding="utf-8")).keys())
except (OSError, ValueError):
    indexed = set()

try:
    from graphify.detect import FileType, classify_file
except Exception:
    sys.exit(0 if kind == "code" else 1)

llm_types = (FileType.DOCUMENT, FileType.PAPER, FileType.IMAGE, FileType.VIDEO)
prefix = str(root) + "/"
for raw in Path(sys.argv[2]).read_text(encoding="utf-8").splitlines():
    rel = raw.strip()
    if not rel:
        continue
    if rel.startswith(prefix):
        rel = rel[len(prefix):]
    path = root / rel
    if path.exists():
        found = classify_file(path)
    elif rel in indexed:
        found = FileType.CODE  # deleted, but the graph still holds its nodes
    else:
        found = None
    if kind == "code" and found is FileType.CODE:
        sys.exit(0)
    if kind == "llm" and found in llm_types:
        sys.exit(0)
sys.exit(1)
PY
}

# ---------------------------------------------------------------- run mode

run_rebuild() {
	local iteration=0
	while [ "$iteration" -lt 2 ]; do
		iteration=$((iteration + 1))

		if [ ! -f "$out/graph.json" ]; then
			log_line "no graph.json in $out; nothing to update"
			return 0
		fi
		if ! have graphify; then
			log_line "graphify CLI not on PATH; skipping rebuild"
			return 0
		fi

		# What kind of change arrived? Asked before the throttle so a commit with
		# nothing for a code-only run to do answers at once, instead of parking a
		# deferred rebuild that would find nothing to rebuild.
		local has_code=0 has_llm=0
		classify_changed code && has_code=1
		classify_changed llm && has_llm=1

		# Code-only by default. Measured 2026-09-22: the headless semantic pass
		# re-extracted five changed docs and produced a third of the nodes the
		# assistant-driven pass had (SYSTEM_MAP.md 65 -> 25, SPEC-UI 76 -> 15,
		# app-ui/README.md 66 -> 8). The shrink guard refused the write, which is
		# the right call but leaves the hook failing on every doc-touching commit
		# and therefore never stamping the throttle. `graphify update` preserves
		# the existing semantic layer and says so itself: "For doc/paper/image
		# changes run /graphify --update in your AI assistant". So the doc refresh
		# stays an explicit act; set GRAPHIFY_REBUILD_DOCS=1 to opt back in.
		local use_docs=0
		if [ "${GRAPHIFY_REBUILD_DOCS:-0}" = "1" ] || [ "${GRAPHIFY_REBUILD_DOCS:-}" = "true" ]; then
			if [ -n "${GEMINI_API_KEY:-}${GOOGLE_API_KEY:-}" ]; then
				use_docs=1
			else
				log_line "GRAPHIFY_REBUILD_DOCS is set but no GEMINI_API_KEY/GOOGLE_API_KEY is in this environment; falling back to code-only"
			fi
		fi

		# A doc-only commit is not a reason to spend 45s re-extracting code that
		# did not change: it gets the advisory below. With the doc pass enabled,
		# a doc change is part of the run and so is a reason to run.
		local want=0
		if [ "$has_code" -eq 1 ]; then
			want=1
		elif [ "$use_docs" -eq 1 ] && [ "$has_llm" -eq 1 ]; then
			want=1
		fi
		if [ "$want" -eq 0 ]; then
			if [ "$has_llm" -eq 1 ]; then
				log_line "no code file changed; doc/paper/image change(s) need an assistant - run /graphify --update, or set GRAPHIFY_REBUILD_DOCS=1"
			else
				log_line "no corpus file changed; skipping rebuild"
			fi
			return 0
		fi

		# Throttle. The follow-up iteration deliberately skips it: its whole
		# purpose is to land the commits that arrived during the first run.
		if [ "$iteration" -eq 1 ] && [ -f "$stamp" ]; then
			local now last age
			now="$(date +%s)"
			last="$(stat -c %Y "$stamp" 2>/dev/null || printf '0')"
			age=$((now - last))
			if [ "$age" -lt "$throttle" ]; then
				# Marking pending alone would leave this change unrebuilt until some
				# later trigger happened to arrive, so a burst whose last commit
				# falls inside the window would leave the graph stale indefinitely.
				# Schedule exactly one deferred run for when the window expires;
				# the marker stops a burst from spawning a sleeper per commit.
				if [ ! -f "$deferred" ]; then
					: >"$deferred"
					local wait_s=$((throttle - age + 2))
					local self
					self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
					# 9>&- matters: the sleeper must not inherit this script's lock fd,
					# or it holds the lock for the whole sleep and every trigger in the
					# meantime takes the wrong branch ("lock held") instead of the
					# throttle branch.
					if have setsid; then
						setsid nohup bash -c "sleep $wait_s; rm -f '$deferred'; exec '$self' run" \
							</dev/null >>"$log" 2>&1 9>&- &
					else
						nohup bash -c "sleep $wait_s; rm -f '$deferred'; exec '$self' run" \
							</dev/null >>"$log" 2>&1 9>&- &
					fi
					log_line "last rebuild was ${age}s ago (< ${throttle}s); deferred rebuild scheduled in ${wait_s}s"
				else
					log_line "last rebuild was ${age}s ago (< ${throttle}s); a deferred rebuild is already scheduled"
				fi
				return 0
			fi
		fi

		local args
		if [ "$use_docs" -eq 1 ]; then
			args=(extract "$root" --backend gemini --max-concurrency 2)
			log_line "rebuild start (iteration ${iteration}, full AST + semantic, $(grep -c . "$changed" 2>/dev/null || printf '0') changed file(s))"
		else
			args=(update "$root")
			log_line "rebuild start (iteration ${iteration}, code-only, $(grep -c . "$changed" 2>/dev/null || printf '0') changed file(s))"
		fi

		local status=0
		# A wedged rebuild must not hold this lock forever: graphify's own lock is
		# blocking, so a concurrent `graphify watch` daemon (or any future blocking
		# wait) would otherwise park this process indefinitely, and every later
		# trigger would only ever mark pending. Exit 124 is the timeout.
		if have timeout; then
			timeout --kill-after=30 "$timeout_s" graphify "${args[@]}" >>"$log" 2>&1 || status=$?
		else
			graphify "${args[@]}" >>"$log" 2>&1 || status=$?
		fi
		if [ "$status" -eq 0 ]; then
			touch "$stamp"
			log_line "rebuild finished"
		elif [ "$status" -eq 124 ]; then
			log_line "rebuild killed after ${timeout_s}s (GRAPHIFY_REBUILD_TIMEOUT); the graph was not rewritten"
		else
			log_line "rebuild failed with exit ${status}; see the output above"
		fi

		# Doc changes are not refreshed by a code-only run, so say so instead of
		# letting the rebuild look complete. A log line rather than a marker
		# file: an assistant-driven refresh cannot clear a marker, so it would
		# age into a standing false alarm.
		if [ "$use_docs" -eq 0 ] && [ "$has_llm" -eq 1 ]; then
			log_line "doc/paper/image changes were not re-extracted; run /graphify --update in an assistant, or set GRAPHIFY_REBUILD_DOCS=1"
		fi

		if [ -f "$pending" ]; then
			rm -f "$pending"
			log_line "a trigger arrived during the rebuild; running once more"
			continue
		fi
		return 0
	done
	log_line "iteration cap reached; the next trigger will pick up any remaining change"
}

# -------------------------------------------------------------- detach mode

detach() {
	mkdir -p "$out"
	if [ -n "${1:-}" ] && [ -f "$1" ]; then
		cp "$1" "$changed"
	else
		changed_files >"$changed" 2>/dev/null || : >"$changed"
	fi

	# Resolve this script's own path first: a detached process may start in a
	# different working directory, and $0 as invoked can be relative.
	local self
	self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

	# setsid detaches from the session so the rebuild survives the terminal that
	# ran the commit; nohup covers hosts without setsid, and the redirects keep
	# git from holding the pipe open waiting on this child. 9>&- closes the lock fd
	# in case this script ever calls detach while holding it.
	if have setsid; then
		setsid nohup "$self" run </dev/null >>"$log" 2>&1 9>&- &
	else
		nohup "$self" run </dev/null >>"$log" 2>&1 9>&- &
	fi
	return 0
}

# --------------------------------------------------------------- entrypoint

case "${1:-detach}" in
run)
	mkdir -p "$out"
	exec 9>>"$lock"
	if ! flock -n 9; then
		: >"$pending"
		log_line "another rebuild holds the lock; marked pending"
		exit 0
	fi
	run_rebuild || log_line "rebuild aborted on an unexpected error"
	;;
detach)
	detach "${2:-}" || true
	;;
*)
	printf 'usage: %s [detach <changed-file-list> | run]\n' "$(basename "$0")" >&2
	exit 2
	;;
esac

# A background refresh never gets to fail the commit or push that triggered it.
exit 0
