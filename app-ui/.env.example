# Panel environment. Copy to .env for local development, never commit .env.
# Parsed by src/lib/schemas/env.ts, which fails with the variable name and the reason.

# Absolute origin of app-serv. The panel forwards /api/v1 to this target from its own server,
# so the browser only ever talks to one origin (docs/SPEC-UI/001-SPEC-UI.md §3.1).
PANEL_API_TARGET=http://127.0.0.1:8080
