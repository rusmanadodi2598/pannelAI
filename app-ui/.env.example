# ============================================================
# APP: app-ui
# ENV TEMPLATE BER-TAG & PRIORITY
# ------------------------------------------------------------
# FORMAT: [P0|P1|P2][TAG:GROUP] Deskripsi singkat
# - docker-deploy.sh menarik secret -> .env (chmod 600) otomatis.
# - JANGAN commit .env (lihat .gitignore). .env.example aman (tanpa secret).
# PRIORITY:
# [P0] Wajib untuk boot production (security, auth, DB, internal).
# [P1] Penting untuk hardening operasional dan reliability.
# [P2] Tuning tambahan / optional sesuai kebutuhan app-gateway/deployment/.
# ============================================================

# [P0][TAG:RUNTIME] Panel runtime: APP_ENV development|production|test, APP_PORT the port the built server binds
APP_ENV=development
APP_PORT=3000

# [P0][TAG:AI_API] Server AI Gateway Api
PANEL_API_TARGET=http://127.0.0.1:9090
