# APP: app-serv
# Env template dengan tag dan priority
# FORMAT: [P0|P1|P2][TAG:GROUP] Deskripsi singkat
# - docker-deploy.sh menarik secret -> .env (chmod 600) otomatis.
# - JANGAN commit .env (lihat .gitignore). .env.example aman (tanpa secret).
# PRIORITY:
# [P0] Wajib untuk boot production (security, auth, DB, internal).
# [P1] Penting untuk hardening operasional dan reliability.
# [P2] Tuning tambahan / optional sesuai kebutuhan app-gateway/deployment/.

# [P0][TAG:RUNTIME] Runtime environment
HTTP_ADDR=:9090
LOG_LEVEL=info
# Deployment profile: development | staging | production. The session cookie is
# Secure by default; the opt-out below exists for local plain-HTTP development
# and production refuses it.
APP_ENV=development
SESSION_COOKIE_INSECURE=false

# [P0][TAG:DATABASE] PostgreSQL. Schemas live in app-serv/migrations/
# Outside APP_ENV=development the DSN must set sslmode=verify-ca or verify-full;
# disable and require are refused at boot.
POSTGRES_DSN=postgres://<user>:<password>@localhost:5432/pannelai?sslmode=disable
DB_POOL_MAX=10

# [P0][TAG:REDIS_CACHE] Redis: sessions, rate limits, sticky round-robin, key circuit state.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=<password>
# TLS off keeps the local plaintext server working. Turn it on wherever Redis
# crosses a network boundary; the CA file is optional and empty means system roots.
REDIS_TLS_ENABLED=false
REDIS_TLS_CA_FILE=
REDIS_POOL_SIZE=20
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# [P0][TAG:SECRET_SESSION] Session cookie signing key. Must be >= 32 random bytes.
SESSION_SECRET=replace-with-32-bytes-of-random-secret-value

# [P0][TAG:SECRET_BOOTSTRAP] Optional first-boot dashboard password. It is bcrypt-hashed into PostgreSQL only when no password exists, and never overwrites a configured password.
PANEL_BOOTSTRAP_PASSWORD=<boostrap_password>

# [P0][TAG:SECRET_ENCRYPTION] AES-256 key protecting upstream key values at rest (upstream_keys). Must be exactly 32 bytes, base64 or raw.
ENCRYPTION_KEY=<replace-with-32-bytes-of-random-key-value>

# [P1][TAG:SESION_TTL] Dashboard session lifetime and login limiter (5 fails -> 15m lockout).
SESSION_TTL=24h
LOGIN_MAX_FAILS=5
LOGIN_LOCKOUT=15m

# [P1][TAG:PREFIX_KEY] Prefix of client-facing gateway keys (key masking: sk-...abcd).
GATEWAY_KEY_PREFIX=sk-

# [P1][TAG:REDIS_RATE_LIMIT] Gateway-wide fixed-window rate limit per client address (Rate limiting).
RATE_LIMIT_PER_MIN=120
# Request logs are purged every two days; this cap bounds a burst between runs.
REQUEST_LOG_MAX_ROWS=20000
# usage_records is billing history, purged separately from the request logs.
USAGE_RETENTION_DAYS=90

# [P1][TAG:EGRESS_ALLOWLIST] Outbound destinations the gateway may dial, as CIDR
# prefixes or single addresses, comma-separated. Loopback and private ranges are
# refused unless named here (OWASP A01). Empty = the guard's defaults only.
EGRESS_ALLOWED_TARGETS=

# [P1][TAG:PROXY_TEST] URL the proxy connectivity test fetches through the
# candidate proxy. Only has to be something a working proxy can reach.
PROXY_TEST_URL=https://www.google.com/

# [P1][TAG:QUOTA_POLL] Knobs on the published-quota sweep: how many accounts one
# tick may ask, and how many of those calls may be in flight.
QUOTA_POLL_BUDGET=40
QUOTA_POLL_CONCURRENCY=4

# [P2][TAG:OAUTH] Absolute URL publik gateway ini, mis. https://ai.example.com
PUBLIC_BASE_URL=<example.com>

# [P2][TAG:OAUTH_CLIENT] Klien OAuth untuk keluarga antigravity dan gemini-cli.
# Keempatnya wajib kalau akun keluarga Google mau disambungkan: bahan klien tidak
# ada di registry, karena dokumen itu ikut ter-commit dan pasangan id+secret
# installed-app Google dibaca tool pemindai sebagai kredensial nyata. Isi dengan
# client installed-app milikmu sendiri, dan daftarkan redirect URI publik ini ke
# Cloud Console: {PUBLIC_BASE_URL}/api/v1/providers/{provider_id}/oauth/callback.
# Provider lain mengikuti aturan yang sama: id boleh dibawa entri, secret selalu
# dari env, dan nama var per provider didaftarkan di internal/config/oauth_clients.go.
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
GEMINI_CLI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_ID=
GEMINI_CLI_OAUTH_CLIENT_ID=

# [P2][TAG:TRUSTED_PROXY] Peers whose X-Forwarded-For the rate limiters may read,
# as CIDR prefixes or single addresses, comma-separated. Empty = every request is
# bucketed by its direct peer and the header is never read.
TRUSTED_PROXY_CIDRS=
