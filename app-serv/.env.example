# app-serv example environment. Copy to .env and fill in real values.
# SPEC-API-001 §4: all values here are read into a typed Config at boot; the
# server fails fast when a required value is missing or out of range.

# Runtime profile. Recognised and reported by the config layer; nothing reads it
# yet, so "production" does not change cookie flags or error detail today.
# It becomes meaningful with the session endpoints (SPEC-API-001 §7.2).
APP_ENV=development

# Listen address. Dev default is :8080 (SPEC-API-001 §12 question 1, resolved 8080).
HTTP_ADDR=:8080

# PostgreSQL. Schemas live in app-serv/migrations/ (SPEC-API-001 §6).
POSTGRES_DSN=postgres://pannelai:pannelai@localhost:5432/pannelai?sslmode=disable

# Redis: sessions, rate limits, sticky round-robin, key circuit state (§4).
REDIS_ADDR=localhost:6379

# Redis password, empty when the server runs without auth.
REDIS_PASSWORD=

# pgx pool size. Every query runs through this bounded pool (NFR 6).
DB_POOL_MAX=10

# slog level: debug, info, warn, error. Internal logs may be Indonesian;
# client payloads never are (SPEC-API-001 §4 Observability).
LOG_LEVEL=info

# Session cookie signing key. Must be >= 32 random bytes.
SESSION_SECRET=replace-with-32-bytes-of-random-secret-value

# AES-256 key protecting upstream key values at rest (§6 upstream_keys).
# Must be exactly 32 bytes, base64 or raw.
ENCRYPTION_KEY=replace-with-32-bytes-of-random-key-value

# Dashboard session lifetime and login limiter (5 fails -> 15m lockout, §7.2).
SESSION_TTL=24h
LOGIN_MAX_FAILS=5
LOGIN_LOCKOUT=15m

# Prefix of client-facing gateway keys (§4 key masking: sk-...abcd).
GATEWAY_KEY_PREFIX=sk-

# Gateway-wide rate limit on public endpoints (§4 Rate limiting).
# NOT ENFORCED YET: no limiter middleware exists, so this value is validated and
# reported but nothing consumes it. Do not rely on it for protection until the
# Redis-backed limiter lands (P1).
RATE_LIMIT_PER_MIN=120
