# ============================================================
# APP: app-serv
# ENV TEMPLATE BER-TAG & PRIORITY
# ------------------------------------------------------------
# FORMAT: [P0|P1|P2][TAG:GROUP] Deskripsi singkat
# - docker-deploy.sh menarik secret -> .env (chmod 600) otomatis.
# - JANGAN commit .env (lihat .gitignore). .env.example aman (tanpa secret).
# PRIORITY:
# [P0] Wajib untuk boot production (security, auth, DB, internal).
# [P1] Penting untuk hardening operasional dan reliability.
# [P2] Tuning tambahan / optional sesuai kebutuhan app-gateway/deployment/.
# ============================================================

# [P0[TAG:RUNTIME] Runtime environment
HTTP_ADDR=:9090
LOG_LEVEL=info

# PostgreSQL. Schemas live in app-serv/migrations/ (SPEC-API-001 §6).
POSTGRES_DSN=postgres://<user>:<password>@localhost:5432/pannelai?sslmode=disable

# Redis: sessions, rate limits, sticky round-robin, key circuit state (§4).
REDIS_ADDR=localhost:6379

# Redis password, empty when the server runs without auth.
REDIS_PASSWORD=<password>

# pgx pool size. Every query runs through this bounded pool (NFR 6).
DB_POOL_MAX=10

# Session cookie signing key. Must be >= 32 random bytes.
SESSION_SECRET=replace-with-32-bytes-of-random-secret-value

# Optional first-boot dashboard password. It is bcrypt-hashed into PostgreSQL
# only when no password exists, and never overwrites a configured password.
PANEL_BOOTSTRAP_PASSWORD=<boostrap_password>

# AES-256 key protecting upstream key values at rest (§6 upstream_keys).
# Must be exactly 32 bytes, base64 or raw.
ENCRYPTION_KEY=<replace-with-32-bytes-of-random-key-value>

# Dashboard session lifetime and login limiter (5 fails -> 15m lockout, §7.2).
SESSION_TTL=24h
LOGIN_MAX_FAILS=5
LOGIN_LOCKOUT=15m

# Prefix of client-facing gateway keys (§4 key masking: sk-...abcd).
GATEWAY_KEY_PREFIX=sk-

# Gateway-wide fixed-window rate limit per client address (§4 Rate limiting).
# Redis enforces this budget for the versioned HTTP surface; health/version probes
# remain unmetered so dependency failures stay observable.
RATE_LIMIT_PER_MIN=120
