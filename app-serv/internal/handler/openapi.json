{
  "openapi": "3.1.0",
  "info": {
    "title": "pannelAI API",
    "summary": "The management and data planes of the pannelAI gateway, the machine-readable form of docs/SPEC-API/001-SPEC-API.md.",
    "version": "v0.4.0",
    "description": "Session cookie auth guards the management plane; the data plane presents Authorization: Bearer <gateway key> when settings.security.require_api_key is true. Errors follow SPEC-API-001 \u00a78 (management) and the OpenAI error shape (data plane)."
  },
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "pannel_session"
      },
      "gatewayKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "A gateway key (sk-...) created through \u00a77.3."
      }
    }
  },
